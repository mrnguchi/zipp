NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3001
DATABASE_URL=postgresql://zipp_app:local_app_only@127.0.0.1:55432/zipp_dev
# Migration-owner credentials belong in .env.migrate, never the runtime environment.
DB_POOL_MAX=5
REDIS_QUEUE_URL=redis://:local_queue_only@127.0.0.1:56379
REDIS_CACHE_URL=redis://:local_cache_only@127.0.0.1:56380
LOG_LEVEL=info
SERVICE_ROLE=api
MANAGEMENT_ENABLED=true
MANAGEMENT_PORT=3002
# Optional. No trace data leaves the process unless a trusted endpoint is configured.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
TRACE_SAMPLE_RATIO=0.1
# Identity fails closed until local keys are generated with scripts/setup-local-auth.mjs.
AUTH_ENABLED=false
AUTH_SIGNING_KEY=
AUTH_DIGEST_KEY=
AUTH_ENCRYPTION_KEY=
AUTH_DELIVERY_MODE=local
# Explicit local-only financial simulation. No real payment provider is connected.
PAYMENTS_ENABLED=false
PAYMENT_ADAPTER=local
PAYMENT_LOCAL_OUTCOME=success
# M4 adapters are local-only and disabled until explicitly enabled for development.
DRIVER_UPLOADS_ENABLED=false
DRIVER_DOCUMENT_STORAGE=local
DRIVER_DOCUMENT_ROOT=./.local/private-documents
PRICING_ENABLED=false
ROUTING_ADAPTER=fixture
RIDES_ENABLED=false

# M6 local-only delivery adapters. No SMS or production object storage configured.
DELIVERIES_ENABLED=false
DELIVERY_CODE_ADAPTER=local
DELIVERY_MEDIA_ENABLED=false
DELIVERY_MEDIA_ADAPTER=local
DELIVERY_MEDIA_ROOT=./.local/delivery-photos

# M7.2 durable chat/tickets: requires communications=m7_2 migration marker when enabled.
COMMUNICATIONS_ENABLED=false
# M7.3 notifications/capture. Generate a dedicated random key before explicit opt-in.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_DATA_KEY=
NOTIFICATION_ADAPTER=capture
# Worker only; capture is never phone/provider delivery.
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_CAPTURE_ROOT=
# M7.4 local control only. No media/provider/native incoming calls.
CALLING_ENABLED=false
OPERATIONS_ENABLED=false
CALLING_ADAPTER=local_control
CALL_SIGNAL_KEY=
# Worker only; does not need API identity or signal keys.
CALLING_REAPER_ENABLED=false
# Optional API-only setup credentials; never a maximum conversation duration.
CALL_RELAY_CREDENTIALS_ENABLED=false
CALL_RELAY_LAN_IP=
# Absolute private prepared turn-shared-secret file; never a raw key env value.
CALL_RELAY_SECRET_FILE=
# M7.1 local participant streams; disabled until explicitly selected for development.
REALTIME_ENABLED=false
REALTIME_ALLOW_NATIVE=false
REALTIME_ALLOWED_ORIGINS=
