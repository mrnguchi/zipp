{
  "title": "Internal communication event/outbox intent v1",
  "description": "Persisted atomically with messages/status. References only; no publisher or notification delivery is enabled in M7.2.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "threadId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "type": {
      "type": "string",
      "enum": [
        "conversation.opened",
        "ticket.opened",
        "message.sent",
        "ticket.reopened",
        "ticket.resolved"
      ]
    },
    "actorUserId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "messageSequence": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "CUSTOMER_REQUEST",
            "ANSWERED",
            "DUPLICATE",
            "FOLLOW_UP",
            "OTHER"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "threadId",
    "schemaVersion",
    "aggregateVersion",
    "type",
    "actorUserId",
    "messageSequence",
    "reason",
    "occurredAt"
  ],
  "additionalProperties": false
}
