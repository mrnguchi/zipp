{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "job.snapshot"
    },
    "jobType": {
      "type": "string",
      "enum": [
        "RIDE",
        "DELIVERY"
      ]
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "status": {
      "type": "string",
      "enum": [
        "SEARCHING",
        "ASSIGNED",
        "ARRIVED",
        "IN_PROGRESS",
        "COMPLETED",
        "CANCELLED",
        "NO_DRIVER",
        "AT_PICKUP",
        "COLLECTED",
        "IN_TRANSIT",
        "AT_DESTINATION",
        "RETURNING",
        "AT_RETURN",
        "DELIVERED",
        "RETURNED",
        "NO_COURIER"
      ]
    },
    "custody": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "WITH_SENDER",
            "WITH_COURIER",
            "WITH_RECIPIENT",
            "RETURNED_TO_SENDER"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "position": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "receivedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "stale": {
              "type": "boolean"
            }
          },
          "required": [
            "latitude",
            "longitude",
            "receivedAt",
            "stale"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "resyncRequired": {
      "type": "boolean"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "jobType",
    "jobId",
    "version",
    "status",
    "custody",
    "terminal",
    "position",
    "resyncRequired",
    "observedAt"
  ],
  "additionalProperties": false
}
