{
  "name": "@zipp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-contracts.mjs",
    "auth:setup": "node scripts/setup-local-auth.mjs",
    "auth:code": "node scripts/read-local-otp.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "services:up": "docker compose -f ../infra/compose/compose.yaml up -d --build api worker",
    "services:down": "docker compose -f ../infra/compose/compose.yaml down",
    "services:test": "node scripts/service-tests.mjs",
    "services:test:down": "docker compose -p zipp-m0-test -f ../infra/compose/compose.yaml -f ../infra/compose/compose.test.yaml down",
    "lint": "eslint src tests prisma.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test:policies": "node --test scripts/policy.test.mjs scripts/deployment.test.mjs",
    "check:policies": "npm run check:boundaries && npm run check:workflows && npm run test:policies",
    "check:negative": "node scripts/negative-gates.mjs",
    "check:migration-gate": "node scripts/migration-gate.mjs",
    "security:audit": "node scripts/audit.mjs",
    "security:secrets": "node scripts/tooling.mjs secrets",
    "security:probe": "node scripts/tooling.mjs secret-probe",
    "security:image": "node scripts/tooling.mjs image",
    "security:sbom": "node scripts/tooling.mjs sbom",
    "lint:workflows": "node scripts/tooling.mjs workflows",
    "test:ci": "npm run test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "monitoring:up": "docker compose -f ../infra/compose/compose.yaml -f ../infra/compose/compose.observability.yaml up -d --build api worker collector prometheus grafana",
    "load:baseline": "node scripts/load.mjs baseline",
    "load:burst": "node scripts/load.mjs burst",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js validate",
    "prisma:migrate:deploy": "node --env-file-if-exists=.env.migrate node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:dev": "node --env-file-if-exists=.env.migrate node_modules/prisma/build/index.js migrate dev",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:e2e": "npm run test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
    "test:integration": "npm run test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "check": "npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm run lint && npm run format:check && npm run check:policies && npm run test:unit && npm run test:e2e && npm run build",
    "delivery:code": "node scripts/read-local-delivery-code.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "bullmq": "5.76.4",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jose": "6.2.17",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.2.0",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "eslint": "10.14.0",
    "jest": "30.2.0",
    "prettier": "3.7.4",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
