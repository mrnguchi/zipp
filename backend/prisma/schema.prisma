  purpose             DeliveryProofPurpose
  requestId           String?              @map("request_id") @db.Uuid
  codeHash            String?              @map("code_hash") @db.Char(64)
  expiresAt           DateTime?            @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime?            @map("consumed_at") @db.Timestamptz(3)
  issuedAt            DateTime?            @map("issued_at") @db.Timestamptz(3)
  issueCount          Int                  @default(0) @map("issue_count")
  issueWindowEndsAt   DateTime?            @map("issue_window_ends_at") @db.Timestamptz(3)
  failureCount        Int                  @default(0) @map("failure_count")
  failureWindowEndsAt DateTime?            @map("failure_window_ends_at") @db.Timestamptz(3)
  delivery            Delivery             @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@id([deliveryId, purpose])
  @@map("delivery_proofs")
}

model DeliveryIssue {
  id               String    @id @default(uuid()) @db.Uuid
  deliveryId       String    @map("delivery_id") @db.Uuid
  openedById       String    @map("opened_by_id") @db.Uuid
  kind             String    @db.VarChar(30)
  reason           String    @db.VarChar(500)
  resolution       String?   @db.VarChar(30)
  resolutionReason String?   @map("resolution_reason") @db.VarChar(500)
  resolvedById     String?   @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  delivery         Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId, createdAt])
  @@map("delivery_issues")
}

model DeliveryRating {
  deliveryId    String   @id @map("delivery_id") @db.Uuid
  bookerUserId  String   @map("booker_user_id") @db.Uuid
  courierUserId String   @map("courier_user_id") @db.Uuid
  stars         Int
  comment       String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@map("delivery_ratings")
}

model DeliveryTrackingCapability {
  requestedTtlSeconds Int       @default(0) @map("requested_ttl_seconds")
  id                  String    @id @default(uuid()) @db.Uuid
  deliveryId          String    @map("delivery_id") @db.Uuid
  issuedById          String    @map("issued_by_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  delivery            Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId, createdAt])
  @@map("delivery_tracking_capabilities")
}
