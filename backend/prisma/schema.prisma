generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

model OperationsCase {
  id             String   @id @db.Uuid
  subjectType    String   @map("subject_type") @db.VarChar(10)
  subjectId      String   @map("subject_id") @db.Uuid
  reasonCode     String   @map("reason_code") @db.VarChar(30)
  description    String   @db.VarChar(2000)
  status         String   @default("OPEN") @db.VarChar(15)
  version        Int      @default(1)
  openedByUserId String   @map("opened_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([subjectType, status, id])
  @@index([subjectType, subjectId])
  @@map("operations_cases")
}

model OperationsCaseEvent {
  id            String   @id @db.Uuid
  caseId        String   @map("case_id") @db.Uuid
  version       Int
  action        String   @db.VarChar(20)
  status        String   @db.VarChar(15)
  reasonCode    String   @map("reason_code") @db.VarChar(30)
  actorUserId   String   @map("actor_user_id") @db.Uuid
  accountStatus String?  @map("account_status") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([caseId, version])
  @@map("operations_case_events")
}

model OperationsCommand {
  actorUserId   String   @map("actor_user_id") @db.Uuid
  operation     String   @db.VarChar(20)
  key           String   @db.Uuid
  fingerprint   String   @db.Char(64)
  caseId        String   @map("case_id") @db.Uuid
  version       Int
  status        String   @db.VarChar(15)
  accountStatus String?  @map("account_status") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([actorUserId, operation, key])
  @@map("operations_commands")
}

enum CommunicationKind {
  JOB
  SUPPORT
}

enum CallStatus {
  RINGING
  CONNECTING
  REJECTED
  MISSED
  FAILED
  ENDED
}

model CallSession {
  id                     String          @id @db.Uuid
  jobId                  String          @map("job_id") @db.Uuid
  jobType                MobilityJobType @map("job_type")
  callerUserId           String          @map("caller_user_id") @db.Uuid
  calleeUserId           String          @map("callee_user_id") @db.Uuid
  callerSessionId        String          @map("caller_session_id") @db.Uuid
  callerDeviceId         String          @map("caller_device_id") @db.Uuid
  callerDeviceGeneration Int             @map("caller_device_generation")
  calleeSessionId        String?         @map("callee_session_id") @db.Uuid
  calleeDeviceId         String?         @map("callee_device_id") @db.Uuid
  calleeDeviceGeneration Int?            @map("callee_device_generation")
  status                 CallStatus      @default(RINGING)
  version                Int             @default(1)
  signalEpoch            Int             @default(0) @map("signal_epoch")
  ringExpiresAt          DateTime        @map("ring_expires_at") @db.Timestamptz(3)
  connectExpiresAt       DateTime?       @map("connect_expires_at") @db.Timestamptz(3)
  acceptedAt             DateTime?       @map("accepted_at") @db.Timestamptz(3)
  endedAt                DateTime?       @map("ended_at") @db.Timestamptz(3)
  endReason              String?         @map("end_reason") @db.VarChar(40)
  lastCheckedAt          DateTime        @default(now()) @map("last_checked_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([callerUserId, calleeUserId, createdAt])
  @@index([status, lastCheckedAt])
  @@map("call_sessions")
}

model ActiveCallParticipant {
  userId String @id @map("user_id") @db.Uuid
  callId String @map("call_id") @db.Uuid
  side   String @db.VarChar(6)

  @@unique([callId, side])
  @@map("active_call_participants")
}

model CallCommand {
  actorUserId String     @map("actor_user_id") @db.Uuid
  operation   String     @db.VarChar(10)
  key         String     @db.Uuid
  fingerprint String     @db.Char(64)
  callId      String     @map("call_id") @db.Uuid
  version     Int
  status      CallStatus
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([actorUserId, operation, key])
  @@map("call_commands")
}

model CallEvent {
  id               String   @id @db.Uuid
  callId           String   @map("call_id") @db.Uuid
  aggregateVersion Int      @map("aggregate_version")
  eventType        String   @map("event_type") @db.VarChar(30)
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  reason           String?  @db.VarChar(40)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([callId, aggregateVersion])
  @@map("call_events")
}

enum NotificationDeliveryStatus {
  PENDING
  CAPTURED
  SUPPRESSED
  REVIEW_REQUIRED
}

model NotificationDevice {
  id              String    @id @db.Uuid
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  platform        String    @db.VarChar(10)
  provider        String    @default("LOCAL") @db.VarChar(10)
  proofHash       String    @map("proof_hash") @db.Char(64)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  tokenCiphertext String?   @map("token_ciphertext") @db.VarChar(1024)
  generation      Int       @default(1)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([id, ownerUserId])
  @@index([ownerUserId, revokedAt, expiresAt])
  @@map("notification_devices")
}

model NotificationOutbox {
  id              String    @id @db.Uuid
  sourceEventId   String    @map("source_event_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  eventType       String    @default("ACTIVITY") @map("event_type") @db.VarChar(20)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([id, recipientUserId])
  @@unique([sourceEventId, recipientUserId])
  @@index([completedAt, createdAt])
  @@map("notification_outbox")
}

model NotificationInbox {
  id          String    @id @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([id, ownerUserId])
  @@index([ownerUserId, id])
  @@map("notification_inbox")
}

model NotificationDelivery {
  id               String                     @id @db.Uuid
  notificationId   String                     @map("notification_id") @db.Uuid
  ownerUserId      String                     @map("owner_user_id") @db.Uuid
  deviceId         String                     @map("device_id") @db.Uuid
  deviceGeneration Int                        @map("device_generation")
  status           NotificationDeliveryStatus @default(PENDING)
  attempts         Int                        @default(0)
  availableAt      DateTime                   @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken       String?                    @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?                  @map("lease_expires_at") @db.Timestamptz(3)
  completedAt      DateTime?                  @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([notificationId, deviceId, deviceGeneration], map: "notification_delivery_identity")
  @@index([status, availableAt, leaseExpiresAt])
  @@map("notification_deliveries")
}

enum CommunicationStatus {
  OPEN
  RESOLVED
}

model CommunicationThread {
  id            String              @id @db.Uuid
  kind          CommunicationKind
  creatorUserId String              @map("creator_user_id") @db.Uuid
  jobId         String?             @map("job_id") @db.Uuid
  jobType       MobilityJobType?    @map("job_type")
  subject       String?             @db.VarChar(120)
  category      String?             @db.VarChar(20)
  status        CommunicationStatus @default(OPEN)
  version       Int                 @default(1)
  lastSequence  Int                 @default(0) @map("last_sequence")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([creatorUserId, kind, status, id])
  @@index([kind, status, id])
  @@index([jobId, kind])
  @@map("communication_threads")
}

model CommunicationMessage {
  id           String   @id @db.Uuid
  threadId     String   @map("thread_id") @db.Uuid
  sequence     Int
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([threadId, sequence])
  @@unique([threadId, id])
  @@map("communication_messages")
}

model CommunicationReadCursor {
  threadId  String   @map("thread_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sequence  Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([threadId, userId])
  @@map("communication_read_cursors")
}

model CommunicationCommand {
  actorUserId String   @map("actor_user_id") @db.Uuid
  operation   String   @db.VarChar(30)
  key         String   @db.Uuid
  fingerprint String   @db.Char(64)
  threadId    String   @map("thread_id") @db.Uuid
  messageId   String?  @map("message_id") @db.Uuid
  sequence    Int?
  version     Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([actorUserId, operation, key])
  @@index([threadId])
  @@map("communication_commands")
}

model CommunicationEvent {
  id               String   @id @db.Uuid
  threadId         String   @map("thread_id") @db.Uuid
  aggregateVersion Int      @map("aggregate_version")
  eventType        String   @map("event_type") @db.VarChar(40)
  actorUserId      String   @map("actor_user_id") @db.Uuid
  messageSequence  Int?     @map("message_sequence")
  reason           String?  @db.VarChar(30)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([threadId, aggregateVersion])
  @@map("communication_events")
}

datasource db {
  provider = "postgresql"
}

// Infrastructure-only migration marker. Product models are designed in their milestones.
model PlatformMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("platform_metadata")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
}

enum UserRole {
  CUSTOMER
  DRIVER
  SUPPORT
  FINANCE
  ADMIN
}

enum ChallengePurpose {
  ENROLL
  LOGIN_SMS
  LOGIN_MFA
  PASSWORD_RESET
}

enum SavedPlaceKind {
  HOME
  WORK
  OTHER
}

model User {
  id                    String          @id @default(uuid()) @db.Uuid
  phone                 String          @unique @db.VarChar(16)
  passwordHash          String?         @map("password_hash") @db.VarChar(256)
  status                UserStatus      @default(PENDING)
  roles                 UserRole[]      @default([CUSTOMER])
  phoneVerifiedAt       DateTime?       @map("phone_verified_at") @db.Timestamptz(3)
  twoFactorSecret       String?         @map("two_factor_secret") @db.VarChar(512)
  pendingTwoFactor      String?         @map("pending_two_factor") @db.VarChar(512)
  pendingTwoFactorUntil DateTime?       @map("pending_two_factor_until") @db.Timestamptz(3)
  pendingMfaAttempts    Int             @default(0) @map("pending_mfa_attempts")
  mfaFailureCount       Int             @default(0) @map("mfa_failure_count")
  mfaFailureUntil       DateTime?       @map("mfa_failure_until") @db.Timestamptz(3)
  lastTotpStep          Int             @default(-1) @map("last_totp_step")
  deletionRequestedAt   DateTime?       @map("deletion_requested_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile               AccountProfile?
  sessions              AuthSession[]
  challenges            AuthChallenge[]
  recoveryCodes         RecoveryCode[]
  savedPlaces           SavedPlace[]
  walletAccounts        WalletAccount[]

  @@map("users")
}

model AccountProfile {
  userId               String   @id @map("user_id") @db.Uuid
  displayName          String   @map("display_name") @db.VarChar(100)
  language             String   @default("en") @db.VarChar(2)
  preferredMode        String   @default("customer") @map("preferred_mode") @db.VarChar(12)
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  marketingConsent     Boolean  @default(false) @map("marketing_consent")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("account_profiles")
}

model AuthSession {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime            @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz(3)
  mfaVerifiedAt DateTime?           @map("mfa_verified_at") @db.Timestamptz(3)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  credentials   RefreshCredential[]

  @@unique([id, userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshCredential {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_credentials")
}

model AuthChallenge {
  id                  String           @id @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  purpose             ChallengePurpose
  codeHash            String?          @map("code_hash") @db.Char(64)
  pendingPasswordHash String?          @map("pending_password_hash") @db.VarChar(256)
  pendingDisplayName  String?          @map("pending_display_name") @db.VarChar(100)
  attempts            Int              @default(0)
  expiresAt           DateTime         @map("expires_at") @db.Timestamptz(3)
  chainExpiresAt      DateTime         @map("chain_expires_at") @db.Timestamptz(3)
  usedAt              DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash") @db.Char(64)
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

model SavedPlace {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      SavedPlaceKind @default(OTHER)
  name      String         @db.VarChar(100)
  label     String         @db.VarChar(200)
  latitude  Float
  longitude Float
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt, id])
  @@map("saved_places")
}

model SecurityAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  subjectId String?  @map("subject_id") @db.Uuid
  action    String   @db.VarChar(96)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@map("security_audit")
}

enum WalletAccountType {
  USER
  PLATFORM
  CLEARING
}

enum ReservationStatus {
  RESERVED
  RELEASED
  CAPTURED
}

enum FinancialOperationType {
  TOP_UP
  WITHDRAWAL
}

enum FinancialOperationStatus {
  AWAITING_APPROVAL
  PENDING_CONFIRMATION
  CONFIRMED
  FAILED
  REJECTED
  REVIEW_REQUIRED
}

model WalletAccount {
  id                String            @id @default(uuid()) @db.Uuid
  ownerUserId       String?           @unique @map("owner_user_id") @db.Uuid
  accountType       WalletAccountType @map("account_type")
  postedAmountXaf   BigInt            @default(0) @map("posted_amount_xaf")
  reservedAmountXaf BigInt            @default(0) @map("reserved_amount_xaf")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  owner             User?             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  postings          LedgerPosting[]
  reservations      FundReservation[]

  @@map("wallet_accounts")
}

model LedgerTransaction {
  id                   String          @id @default(uuid()) @db.Uuid
  businessKey          String          @unique @map("business_key") @db.VarChar(160)
  description          String          @db.VarChar(160)
  postingTransactionId String          @default(dbgenerated("(pg_current_xact_id())::text")) @map("posting_transaction_id") @db.VarChar(32)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  postings             LedgerPosting[]

  @@map("ledger_transactions")
}

model LedgerPosting {
  id                  String            @id @default(uuid()) @db.Uuid
  ledgerTransactionId String            @map("ledger_transaction_id") @db.Uuid
  walletAccountId     String            @map("wallet_account_id") @db.Uuid
  amountXaf           BigInt            @map("amount_xaf")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction         LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  account             WalletAccount     @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  @@unique([ledgerTransactionId, walletAccountId])
  @@index([walletAccountId, createdAt, id])
  @@map("ledger_postings")
}

model FundReservation {
  capturedAmountXaf    BigInt?           @map("captured_amount_xaf")
  id                   String            @id @default(uuid()) @db.Uuid
  walletAccountId      String            @map("wallet_account_id") @db.Uuid
  businessKey          String            @unique @map("business_key") @db.VarChar(160)
  amountXaf            BigInt            @map("amount_xaf")
  refundedAmountXaf    BigInt            @default(0) @map("refunded_amount_xaf")
  status               ReservationStatus @default(RESERVED)
  beneficiaryAccountId String?           @map("beneficiary_account_id") @db.Uuid
  platformFeeXaf       BigInt?           @map("platform_fee_xaf")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  account              WalletAccount     @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  @@index([walletAccountId, status])
  @@map("fund_reservations")
}

model FinancialOperation {
  id                String                   @id @default(uuid()) @db.Uuid
  ownerUserId       String                   @map("owner_user_id") @db.Uuid
  operationType     FinancialOperationType   @map("operation_type")
  status            FinancialOperationStatus
  amountXaf         BigInt                   @map("amount_xaf")
  reservationId     String?                  @unique @map("reservation_id") @db.Uuid
  failureCode       String?                  @map("failure_code") @db.VarChar(80)
  completedAt       DateTime?                @map("completed_at") @db.Timestamptz(3)
  responseExpiresAt DateTime?                @map("response_expires_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  attempt           PaymentAttempt?
  withdrawal        WithdrawalRequest?

  @@index([ownerUserId, createdAt, id])
  @@index([status, createdAt])
  @@map("financial_operations")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  operationType      String   @map("operation_type") @db.VarChar(80)
  requestKey         String   @map("request_key") @db.Uuid
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  requestReason      String?  @map("request_reason") @db.VarChar(300)
  operationId        String   @map("operation_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorUserId, operationType, requestKey])
  @@map("idempotency_records")
}

model PaymentAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  operationId       String             @unique @map("operation_id") @db.Uuid
  providerReference String             @unique @map("provider_reference") @db.Uuid
  providerName      String             @default("local") @map("provider_name") @db.VarChar(32)
  simulatedOutcome  String             @map("simulated_outcome") @db.VarChar(32)
  operation         FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@map("payment_attempts")
}

model WithdrawalRequest {
  id           String             @id @default(uuid()) @db.Uuid
  operationId  String             @unique @map("operation_id") @db.Uuid
  reviewedById String?            @map("reviewed_by_id") @db.Uuid
  reviewReason String?            @map("review_reason") @db.VarChar(300)
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  operation    FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@map("withdrawal_requests")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  operationId      String    @unique @map("operation_id") @db.Uuid
  eventType        String    @default("finance.payment_requested") @map("event_type") @db.VarChar(80)
  schemaVersion    Int       @default(1) @map("schema_version")
  aggregateVersion Int       @default(1) @map("aggregate_version")
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken       String?   @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

