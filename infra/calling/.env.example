# Documentation/source-review values ONLY. Preparation creates .local/compose.env.
# Select an assigned RFC1918 interface address; do not copy this example as yours.
ZIPP_TURN_LAN_IP=192.168.1.50
# POSIX preparation uses your non-root UID/GID; Windows uses 65534.
ZIPP_TURN_UID=65534
ZIPP_TURN_GID=65534
# Shared secrets are NEVER environment variables. See M7_TURN_RELAY.md.
