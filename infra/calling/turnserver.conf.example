# REFERENCE ONLY; never mounted by the local Compose profile.
# Secret intentionally absent: this is not a usable relay config.
# prepare-local-relay.mjs creates the complete private .local/turnserver.conf.
# Read docs/backend/M7_TURN_RELAY.md and ADR 0019 before topology changes.
listening-ip=172.30.240.2
relay-ip=172.30.240.2
listening-port=3478
realm=zipp.voice.local.invalid
fingerprint
use-auth-secret
# Preparation inserts static-auth-secret in the PRIVATE generated file only.
no-auth-pings
no-dynamic-ip-list
no-dynamic-realms
allocation-default-address-family=ipv4
no-tls
dtls=false
no-tcp-relay
no-stun
no-cli
no-multicast-peers
software-attribute=false
stateless-nonce
stale-nonce=600
unauthorized-ratelimit=enforce
unauthorized-ratelimit-rps=5
max-allocate-timeout=10
# Refresh bound, not immediate revocation or maximum call duration.
max-allocate-lifetime=60
user-quota=2
total-quota=20
min-port=49160
max-port=49179
max-bps=64000
bps-capacity=1280000
relay-threads=1
cpus=1
# Both callers must relay through allocations on THIS container.
denied-peer-ip=0.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
allowed-peer-ip=172.30.240.2
pidfile=/tmp/turnserver.pid
log-file=/dev/null
no-stdout-log
