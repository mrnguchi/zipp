{
  "uid": "zipp-foundation",
  "title": "Zipp foundation",
  "tags": [
    "zipp",
    "foundation"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipp-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(zipp_http_duration_seconds_count[1m]))",
          "legendFormat": "{{service}} {{dependency}} {{state}} {{role}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipp-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,service) (rate(zipp_http_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}} {{dependency}} {{state}} {{role}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP server errors",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipp-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(zipp_http_duration_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "{{service}} {{dependency}} {{state}} {{role}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
