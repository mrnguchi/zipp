EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Photon-compatible endpoint; use a managed/self-hosted endpoint for production.
EXPO_PUBLIC_PLACE_SEARCH_URL=https://photon.komoot.io/api/
# OSRM-compatible driving route endpoint; use a dedicated endpoint in production.
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Opt into server-backed delivery and authentication; false keeps the existing visual demo.
EXPO_PUBLIC_DELIVERY_API_ENABLED=false

# M7 participant websocket stream, with periodic REST recovery.
EXPO_PUBLIC_REALTIME_ENABLED=false
# Optional M7 foreground REST communications/inbox. No real push/native calling.
EXPO_PUBLIC_COMMUNICATIONS_ENABLED=false
EXPO_PUBLIC_NOTIFICATION_INBOX_ENABLED=false
