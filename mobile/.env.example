EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Photon-compatible endpoint; use a managed/self-hosted endpoint for production.
EXPO_PUBLIC_PLACE_SEARCH_URL=https://photon.komoot.io/api/
# OSRM-compatible driving route endpoint; use a dedicated endpoint in production.
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Optional Mapbox public token (pk.*) to enable the traffic layer.
# Public client token only; never put a secret sk.* token in this app.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
