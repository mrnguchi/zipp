{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "voice-development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "ZIPP_NATIVE_VOICE_BUILD": "true"
      }
    },
    "development": {
      "developmentClient": true,
